#![feature(raw_ref_op)]

fn main() {
    // Unsuffixed numeric literals and generic calls need the expected type.
    let mut scalar: u64 = 0;
    scalar = scalar.wrapping_add(1);
    let mut array: [u8; 2] = [0; 2];
    array[0] = array[0].wrapping_add(1);
    let float: f32 = 0.;
    assert_eq!(float.abs(), 0.);
    let args: Vec<Vec<u8>> = ["arg"].iter().map(|s| s.as_bytes().to_vec()).collect();
    assert_eq!(args.len(), 1);

    // The annotation also supplies types through local paths and aggregates.
    let source = 0;
    let from_local: u64 = source;
    // Method calls need the receiver's type, so these fail to compile without the kept annotation.
    from_local.count_ones();
    let tuple: (u64, f32) = (0, 0.);
    let empty: [u8; 0] = [];
    tuple.0.count_ones();
    assert_eq!(empty.len(), 0);

    // Preserve coercions at both the outer initializer and aggregate elements.
    let mut pointer: *const u8 = 0 as *mut u8;
    pointer = std::ptr::null::<u8>();
    let mut pointers: [*const u8; 1] = [0 as *mut u8];
    pointers[0] = std::ptr::null::<u8>();
    let mut pointer_tuple: (*const u8,) = (0 as *mut u8,);
    pointer_tuple.0 = std::ptr::null::<u8>();
    let mut slice: &[u8] = b"a";
    slice = b"longer";
    let mut slices: (&[u8],) = (b"a",);
    slices.0 = b"longer";
    let mut callback: fn(u8) -> u8 = |x| x;
    callback = |x| x + 1;
    assert_eq!(callback(1), 2);
    let mut target = 0u8;
    let raw: *mut u8 = &mut target;
    assert!(!raw.is_null());

    // A cast containing `_` is not an independent source of type information.
    let inferred_pointer: *const u8 = 0 as *const _;
    assert!(inferred_pointer.is_null());

    // Remove annotations already supplied by the initializer, including through type aliases.
    type Word = u64;

    let fixed = 1u64;
    let cast = 1 as Word;
    let negative = -1i64;
    let boolean = !false;
    let character = 'a';
    let string = "hello";
    let bytes = b"hi";
    let fixed_array = [1u8, 2u8];
    let fixed_repeat = [1u8; 2];
    let fixed_tuple = (1u64, 0f32);
    let unit = ();
}

struct S {
    a: i32,
    b: f32,
}

impl S {
    fn new() -> Self {
        S { a: 0, b: 0. }
    }

    fn get(&self) -> i32 {
        self.a
    }

    fn make<T: Default>(&self) -> T {
        T::default()
    }
}

union U {
    a: u32,
    b: f32,
}

enum E {
    V { x: u64 },
}

struct Unit;

struct Pair(i32, i32);

struct W<T> {
    x: T,
}

impl<T: Default> W<T> {
    fn new() -> Self {
        W { x: T::default() }
    }
}

#[derive(Clone, Copy)]
struct M(u8);

impl std::ops::Add for M {
    type Output = u16;

    fn add(self, other: M) -> u16 {
        self.0 as u16 + other.0 as u16
    }
}

struct Any;

impl<T> std::ops::Add<T> for Any {
    type Output = T;

    fn add(self, rhs: T) -> T {
        rhs
    }
}

fn diverge() -> ! {
    loop {}
}

const K: u64 = 1;
static ST: i32 = 0;

fn g(a: i32) -> i32 {
    a
}

fn id<T>(x: T) -> T {
    x
}

// Paths have fixed types when they name parameters, annotated `let`s, `let`s whose
// initializers have independent types, constants, or statics.
fn paths(param: u64, r: &mut u8) {
    let from_param = param;
    let annotated: i32 = 0;
    let from_annotated = annotated;
    let suffixed = 1u8;
    let from_suffixed = suffixed;
    let (first, second): (i32, f32) = (0, 0.);

    let from_pattern = second;
    let S { a: field, .. } = S::new();
    let from_field_pattern = field;
    let constant = K;
    let static_value = ST;
    let assoc_const = u32::MAX;

    // Keep annotations that determine an inferred local's type.
    let partial: Vec<_> = Vec::new();
    let from_partial: Vec<u64> = partial;
    let W { x: inferred }: W<_> = W { x: 0 };
    let from_inferred_field_pattern: u64 = inferred;
    let closure = |x| {
        let from_closure_param: u64 = x;
        from_closure_param
    };
    closure(0).count_ones();

    // Keep a reborrow, which would otherwise become a move.
    let reborrow: &mut u8 = r;
    *reborrow = 1;
    *r = 2;
}

// A non-generic struct, union, or variant has its type regardless of its fields.
fn aggregates(s: S) {
    let literal = S { a: 0, b: 0. };
    let with_base = S { a: 1, ..s };
    let union_literal = U { a: 0 };
    let variant = E::V { x: 0 };
    let unit_struct = Unit;
    let tuple_struct = Pair(0, 0);

    // A generic ADT gets its type arguments from the annotation.
    let generic: W<u64> = W { x: 0 };
    generic.x.count_ones();
    let none: Option<u64> = None;
    let some: Option<u64> = Some(0);
    some.unwrap().count_ones();
}

// Field types follow from the base's type, including through auto-deref.
fn fields(s: S, r: &S, tuple: (u64, f32), w: W<u64>) {
    let field = s.a;
    let auto_deref = r.b;
    let tuple_field = tuple.0;
    let generic_field = w.x;

    // Keep the annotation when it determines the base's type.
    let inferred = W { x: 0 };
    let inferred_field: u64 = inferred.x;
    inferred.x.count_ones();
}

// Non-generic functions, methods, and constructors return fixed types.
fn calls(s: S, n: u64) {
    let call = g(0);
    let assoc_fn = S::new();
    let method = s.get();
    let inherent = n.count_ones();
    let literal_receiver = 1u32.wrapping_add(2);

    // Generic callees, including through their impl or trait, get their type arguments
    // from the annotation.
    let generic_call: u64 = id(0);
    generic_call.count_ones();
    let generic_impl: W<u64> = W::new();
    let generic_method: u64 = s.make();
    let trait_method: u64 = Default::default();
    let literal_into: u64 = 1u32.into();
}

// Operators on independently typed operands, including overloaded ones, have fixed
// types, and comparisons and lazy boolean operators are always `bool`.
fn operators(a: i32, b: i32, m: M) {
    let sum = a + b;
    let cast_operand = a * 2 as i32;
    let shifted = a << 1u8;
    let overloaded = m + m;
    let compared = 1 == 2;
    let both = a < b && Default::default();

    // Literal operands get their type from the annotation.
    let literal_sum: u64 = 1 + 2;
    let literal_shift: u64 = 1 << a;
    literal_sum.count_ones();
    literal_shift.count_ones();
}

// An operand of type `!`, directly or through a local, is coerced to an inference
// variable that only the annotation determines. Without it, these sums would be `()`.
fn diverging_operand() {
    let sum: u64 = Any + diverge();
}

fn diverging_local() {
    let never = diverge();
    let sum: u64 = Any + never;
}

// An initializer of type `!` is itself coerced to the annotated type.
fn diverging_init() {
    let never: u64 = diverge();
}

// Initializers inside closures are checked with their enclosing function.
fn closures() {
    let closure = || {
        let fixed = 1u64;
        let unsuffixed: u64 = 1;
        fixed + unsuffixed
    };
    assert_eq!(closure(), 2);
}

// Array lengths have their own typeck results, so their annotations are conservatively kept.
fn nested_bodies() {
    let array = [0u8; {
        let len: usize = 3usize;
        len
    }];
    assert_eq!(array.len(), 3);
}

// Parentheses don't appear in the HIR, so the inner expression is checked.
#[allow(unused_parens)]
fn parenthesized() {
    let paren = 1u32;
}

extern "C" {
    fn abs(x: i32) -> i32;
}

// Dereferences follow from the pointer's type, and foreign functions aren't generic.
unsafe fn pointers(p: *const S, q: *mut i32) {
    let deref = *q;
    let deref_field = (*p).a;
    let foreign_call = abs(-1);

    // Keep the annotation when it determines what a generic `Box` holds.
    let boxed = Box::new(0);
    let unboxed: u64 = *boxed;
    unboxed.count_ones();
}

// Associated types of type parameters can't be normalized, but compare equal as written.
fn projections<I: Iterator>(mut iter: I, item: I::Item, r: &I::Item)
where
    I::Item: std::fmt::Debug,
{
    let by_value = item;
    let next: Option<I::Item> = iter.next();
    let debug: &dyn std::fmt::Debug = r;
    println!("{debug:?}");
}

// Types with bound regions are equal regardless of where they are written.
fn bound_regions(f: fn(&u8) -> &u8) {
    let callback = f;
}

struct Table;

impl std::ops::Index<usize> for Table {
    type Output = u16;

    fn index(&self, _: usize) -> &u16 {
        &0
    }
}

struct Grid<T>(Vec<T>);

impl<T> Grid<T> {
    fn new() -> Self {
        Grid(Vec::new())
    }

    fn me(self) -> Self {
        self
    }
}

impl<T> std::ops::Index<usize> for Grid<T> {
    type Output = T;

    fn index(&self, i: usize) -> &T {
        &self.0[i]
    }
}

// Borrowing or indexing a place of fixed type gives a fixed type, and the indexed element
// type follows from the base's type, including for overloaded `Index` impls.
fn places(
    mut n: u64,
    mut array: [u8; 4],
    v: Vec<u8>,
    slice: &[u8],
    i: usize,
    t: Table,
    g: Grid<u64>,
) {
    let shared = &n;
    let exclusive: &mut u64 = &mut n;

    let raw_const = &raw const n;
    let raw_mut = &raw mut n;
    let from_array = array[i];
    let from_vec = v[i as usize];
    let from_slice = slice[3usize];
    let from_table = t[i];
    let from_grid = g[i];
    let element_ref = &array[i];
    let element_raw = &raw mut array[i];
    let unsized_full = &v[..];

    // Keep annotations that coerce the borrow, including an exclusive reborrow.
    let mut target = S::new();
    let pointer: *mut S = &mut target;
    let const_pointer: *const u64 = &n;
    let const_raw: *const u64 = &raw mut n;
    let object: &dyn std::fmt::Debug = &n;
    let unsized_array: &[u8] = &[1u8, 2u8];
    let unsized_local: &[u8] = &array;
    let unsized_range: &[u8] = &v[1..2];

    // Keep annotations that determine the borrowed or indexed type.
    let literal: &u64 = &0;
    let scalar = 0;
    let borrowed: &u64 = &scalar;
    let first: u8 = array[0];
    let inferred = Vec::new();
    let from_inferred: u8 = inferred[0usize];
    let inferred_grid = Grid::new();
    let from_inferred_grid: u64 = inferred_grid[0usize];
    inferred_grid[0usize].count_ones();
}

// A method of a generic inherent impl, such as `offset` from `impl<T> *const T`, gets
// the impl's type arguments from the receiver's type, and its own from explicit ones.
unsafe fn receivers(p: *const i32, s: *const S, array: [u8; 4], g: Grid<u64>) {
    let element = *p.offset(1);
    let element_field = (*s.offset(1)).a;
    let offset = p.offset(1);
    let autoref = array.as_ptr();
    let self_typed = g.me();
    let explicit = p.cast::<u8>();

    // Keep the annotation when it determines a method's own type argument or the
    // receiver's type.
    let own: *const u8 = p.cast();
    let mut inferred = Vec::new();
    let popped: Option<u64> = inferred.pop();
}

struct Callbacks {
    cb: Option<fn(i32) -> i32>,
}

// A function pointer's signature fixes the call's type, and explicit generic arguments
// fix a generic function's.
fn callees(c: &Callbacks, f: fn(u8) -> u64) {
    let through_option = c.cb.expect("non-null function pointer")(1);
    let pointer_call = f(1);
    let null = std::ptr::null_mut::<S>();
    let turbofish = id::<u64>(0);

    // Keep the annotation when it determines an inferred generic argument.
    let partial: *mut u64 = std::ptr::null_mut::<_>();
}

extern "C" {
    static EXT: i32;
}

// Fails to compile if a kept coercion's annotation is dropped.
fn want<T>(_: &T) {}

// A block's tail and an `if`'s branches are checked like the initializer itself.
fn branches(c: bool, n: u64, q: *mut u8, r: *const u8) {
    let block = {
        let mut init = S { a: 0, b: 0. };
        init
    };
    let unsafe_block = unsafe { EXT };
    let ternary = if c { n } else { n + 1u64 };
    let chain = if c {
        q
    } else if n > 0 {
        q
    } else {
        q
    };

    // Keep annotations that coerce a tail, a branch, or a labeled block's `break` value.
    let tail: *const u8 = { q };
    want::<*const u8>(&tail);
    let branch: *const u8 = if c { q } else { q };
    want::<*const u8>(&branch);
    let labeled: *const u8 = 'a: {
        if c {
            break 'a q;
        }
        r
    };
}
