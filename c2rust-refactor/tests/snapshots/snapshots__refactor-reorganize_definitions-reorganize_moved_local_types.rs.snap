#![feature(extern_types, register_tool)]
#![register_tool(c2rust)]
#![allow(dead_code, non_camel_case_types, unused_imports)]

pub mod constants_h {
    pub const OTHER_KIND: crate::source::word_0 = 3 as crate::source::word_0;
}
pub mod geometry_h {
    #[repr(C)]
    pub struct Bounds {
        pub coords: [crate::source::Coord; 4],
        pub generic: crate::source::LocalGeneric<u8>,
        pub handle: *mut crate::source::Opaque,
    }

    pub const KIND: crate::source::word_0 = 2 as crate::source::word_0;

    #[no_mangle]

    pub static mut LEVEL: *const i32 = unsafe { &crate::source::DEFAULT_LEVEL as *const i32 };
}
pub mod word_h {
    pub type word_0 = u64;
}
pub mod other {}

pub mod source {
    #[derive(Copy, Clone)]
    #[repr(C)]
    pub union Coord {
        pub integer: i32,
        pub real: f32,
    }

    pub type word_0 = u32;

    pub struct LocalGeneric<T>(pub T);

    // Items in an `extern` block are named through the enclosing module.
    extern "C" {
        pub type Opaque;
        pub static DEFAULT_LEVEL: i32;
    }

    pub mod geometry_h {
        use crate::source::word_0;
        use crate::source::Coord;
        use crate::source::LocalGeneric;
        use crate::source::Opaque;
        use crate::source::DEFAULT_LEVEL;

        // These imports remain with the header's function, but Bounds, KIND,
        // and LEVEL move to a shared module and still need to name their
        // types and values.
        pub unsafe fn read(coord: Coord, generic: LocalGeneric<u8>, handle: *mut Opaque) -> word_0 {
            coord.integer as word_0 + generic.0 as word_0 + DEFAULT_LEVEL as word_0
        }
    }

    pub fn kind() -> word_0 {
        crate::geometry_h::KIND
    }
}

fn main() {}
