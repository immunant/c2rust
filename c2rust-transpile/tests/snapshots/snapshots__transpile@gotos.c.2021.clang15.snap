pub unsafe extern "C" fn multi_goto_error_common(mut x: ::core::ffi::c_int) -> ::core::ffi::c_int {
    '_common: {
        '_also_bad: {
            '_bad: {
                if x != 0 {
                    x += 1 as ::core::ffi::c_int;
                    if x != 0 {
